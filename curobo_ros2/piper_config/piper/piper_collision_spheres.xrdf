format: "xrdf"

format_version: 1.0

default_joint_positions: 
  joint1: 0.0
  joint2: 0.0
  joint3: -0.0
  joint4: -0.0
  joint5: -0.0005
  joint6: 0.0
  joint7: 0.0
  joint8: -0.0

cspace: 
  joint_names: 
    - "joint1"
    - "joint2"
    - "joint3"
    - "joint4"
    - "joint5"
    - "joint6"
  acceleration_limits: [10, 10, 10, 10, 10, 10]
  jerk_limits: [10000, 10000, 10000, 10000, 10000, 10000]

collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    base_link: 
      - "link1"
    link1: 
      - "link2"
    link2: 
      - "link3"
    link3: 
      - "link4"
    link4: 
      - "link5"
    link5: 
      - "link6"
    link6: 
      - "link7"
      - "link8"
    link7: 
      - "link8"

geometry: 
  auto_generated_collision_sphere_group: 
    spheres: 
      link1: 
        - center: [-0.01, -0.0, -0.007]
          radius: 0.05
      link2: 
        - center: [0.276, -0.014, -0.0]
          radius: 0.05
        - center: [0.06, -0.015, -0.0]
          radius: 0.04
        - center: [0.213, -0.037, -0.0]
          radius: 0.04
        - center: [0.111, -0.023, -0.0]
          radius: 0.04
        - center: [0.162, -0.03, -0.0]
          radius: 0.04
      link3: 
        - center: [-0.008, -0.025, 0.0]
          radius: 0.05
        - center: [-0.018, -0.078, 0.0]
          radius: 0.04
        - center: [-0.022, -0.19, -0.007]
          radius: 0.04
        - center: [-0.019, -0.141, 0.0]
          radius: 0.04
      link4: 
        - center: [0.0, 0.0, -0.009]
          radius: 0.04
      link5: 
        - center: [-0.0, -0.035, -0.0]
          radius: 0.04
        - center: [-0.0, -0.066, 0.0]
          radius: 0.04
      link6: 
        - center: [-0.0, -0.0, 0.015]
          radius: 0.04
        - center: [0.0, 0.063, 0.052]
          radius: 0.02
        - center: [-0.0, -0.065, 0.055]
          radius: 0.02
        - center: [-0.0, 0.037, 0.053]
          radius: 0.02
        - center: [-0.0, 0.012, 0.053]
          radius: 0.02
        - center: [-0.0, -0.014, 0.054]
          radius: 0.02
        - center: [-0.0, -0.04, 0.054]
          radius: 0.02
